# Recorded sessions. Sanitized by calm_core/session_log.py, but a run's events
# are evaluation data belonging to that run rather than to the repository, and
# they accumulate.
logs/

venv/
__pycache__/
*.pyc

# Local assistant/editor metadata
.claude/

# Generated scratch outputs and analysis artifacts
tmp/
graphify-out/
archive/legacy_vector_db_raw_pdf_2026-07-31/

# Build artifact from scripts/make_colab_bundle.py. Regenerated on demand and
# ~1.6 MB of duplicated corpus, so it has no business in history.
calm_bench_bundle.zip

# API keys. These patterns stay as the seatbelt for anything that is NOT the
# deliberately shared key below.
key.txt
*.key
secrets.*

# Common local caches and secrets
.pytest_cache/
.mypy_cache/
.ruff_cache/
# `.env` is COMMITTED here, deliberately, at the project owner's direction, so
# that a collaborator can clone and run without setting anything up. The key in
# it is spend-capped, which bounds the exposure to that cap.
#
# What the cap does NOT bound: OpenRouter is a GitHub secret-scanning partner,
# so this key may be flagged and revoked at any time. When that happens KALMA
# does NOT error -- it falls back to reviewed deterministic text and keeps
# answering (llm_used: false, answer_source: deterministic_fallback), so the
# symptom is silent. Rotating is one line in this one file.
#
# Anything else .env-shaped stays ignored.
.env.*
!.env.example
