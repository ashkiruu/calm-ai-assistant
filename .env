# CALM assistant settings, committed deliberately so a fresh clone runs.
# An environment variable you set yourself always wins over anything here.
#
# This key is spend-capped. If KALMA starts answering with llm_used: false,
# the key was most likely flagged and revoked -- replace the line below.
OPENROUTER_API_KEY=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

# The benchmarked recommendation (MIT-licensed, 14/14 on locale).
CALM_LLM_PROVIDER=openrouter
CALM_OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Whisper CUDA probes OK then fails at inference on some machines; CPU is safe.
CALM_WHISPER_DEVICE=cpu
