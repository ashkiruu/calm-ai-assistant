# Template for .env. The real .env is committed in this repo with a working
# spend-capped key, so you normally do not need this file at all.
#
# Use it when that shared key has been revoked and you want to run on your own:
# copy to .env, paste your key from https://openrouter.ai/keys, restart the
# server. A variable already set in your environment wins over this file.

OPENROUTER_API_KEY=sk-or-v1-your-key-here

# openrouter | ollama
CALM_LLM_PROVIDER=openrouter
CALM_OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Best free-tier alternative if you are running on your own key:
# CALM_OPENROUTER_MODEL=inclusionai/ling-3.0-flash-vl:free

CALM_WHISPER_DEVICE=cpu
